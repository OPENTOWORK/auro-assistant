# Supabase — proyecto "Auro asistente personal"
# Dashboard → Settings → API: https://supabase.com/dashboard/project/_/settings/api
# Configuración rápida: npm run setup:supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Nuevas claves (2025+): sb_publishable_... y sb_secret_...
# Legacy: anon (JWT) y service_role (JWT) — también válidas
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Postgres directo (solo servidor — migraciones: npm run migrate:tasks)
# Settings → Database → Connection string → URI
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# OpenAI (solo servidor — NUNCA exponer en cliente)
OPENAI_API_KEY=sk-tu-api-key
OPENAI_MODEL=gpt-4o-mini

# Usuario principal (memoria y chat)
AURO_OWNER_EMAIL=carlosgarciacano87@gmail.com

# Webhooks n8n (opcional — solo servidor)
N8N_WEBHOOK_SECRET=tu-secreto-compartido-con-n8n

# n8n local: OAuth redirect = http://localhost:5678/rest/oauth2-credential/callback
# Guía completa: n8n/README.md
