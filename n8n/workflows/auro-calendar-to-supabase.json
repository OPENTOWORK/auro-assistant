{
  "name": "Auro — Calendar → Supabase",
  "nodes": [
    {
      "parameters": {},
      "id": "a2000001-0001-4000-8000-000000000011",
      "name": "Ejecutar ahora",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-200, 120]
    },
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 15 }]
        }
      },
      "id": "a2000001-0001-4000-8000-000000000002",
      "name": "Cada 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst min = new Date(now);\nmin.setDate(min.getDate() - 1);\nconst max = new Date(now);\nmax.setDate(max.getDate() + 30);\nreturn {\n  json: {\n    timeMin: min.toISOString(),\n    timeMax: max.toISOString(),\n  },\n};"
      },
      "id": "a2000001-0001-4000-8000-000000000010",
      "name": "Rango fechas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": "primary"
        },
        "returnAll": true,
        "options": {
          "timeMin": "={{ $json.timeMin }}",
          "timeMax": "={{ $json.timeMax }}",
          "singleEvents": true,
          "orderBy": "startTime"
        }
      },
      "id": "a2000001-0001-4000-8000-000000000003",
      "name": "Eventos próximos 14d",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [440, 0],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "REPLACE_GOOGLE_CALENDAR_CREDENTIAL_ID",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ev = $input.item.json;\n\nconst startRaw = ev.start?.dateTime || ev.start?.date;\nconst endRaw = ev.end?.dateTime || ev.end?.date;\n\nif (!startRaw || !endRaw) {\n  return [];\n}\n\nconst allDay = Boolean(ev.start?.date && !ev.start?.dateTime);\n\nfunction toIso(value, isDateOnly) {\n  if (isDateOnly) return `${value}T00:00:00.000Z`;\n  return new Date(value).toISOString();\n}\n\nreturn {\n  json: {\n    title: ev.summary || '(Sin título)',\n    description: ev.description || null,\n    start_at: toIso(startRaw, allDay),\n    end_at: toIso(endRaw, allDay),\n    all_day: allDay,\n    calendar_name: ev.organizer?.displayName || 'Principal',\n    location: ev.location || null,\n    html_link: ev.htmlLink || null,\n    google_event_id: ev.id,\n  },\n};"
      },
      "id": "a2000001-0001-4000-8000-000000000004",
      "name": "Mapear evento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "operation": "upsert",
        "schema": {
          "__rl": true,
          "mode": "list",
          "value": "public"
        },
        "table": {
          "__rl": true,
          "mode": "list",
          "value": "calendar_events"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "title": "={{ $json.title }}",
            "description": "={{ $json.description }}",
            "start_at": "={{ $json.start_at }}",
            "end_at": "={{ $json.end_at }}",
            "all_day": "={{ $json.all_day }}",
            "calendar_name": "={{ $json.calendar_name }}",
            "location": "={{ $json.location }}",
            "html_link": "={{ $json.html_link }}",
            "google_event_id": "={{ $json.google_event_id }}"
          },
          "matchingColumns": ["google_event_id"]
        },
        "options": {}
      },
      "id": "a2000001-0001-4000-8000-000000000005",
      "name": "Upsert Supabase",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [880, 0],
      "credentials": {
        "postgres": {
          "id": "REPLACE_POSTGRES_CREDENTIAL_ID",
          "name": "Auro Supabase Postgres"
        }
      }
    }
  ],
  "connections": {
    "Ejecutar ahora": {
      "main": [[{ "node": "Rango fechas", "type": "main", "index": 0 }]]
    },
    "Cada 15 min": {
      "main": [[{ "node": "Rango fechas", "type": "main", "index": 0 }]]
    },
    "Rango fechas": {
      "main": [[{ "node": "Eventos próximos 14d", "type": "main", "index": 0 }]]
    },
    "Eventos próximos 14d": {
      "main": [[{ "node": "Mapear evento", "type": "main", "index": 0 }]]
    },
    "Mapear evento": {
      "main": [[{ "node": "Upsert Supabase", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": false },
  "tags": [{ "name": "auro" }]
}
